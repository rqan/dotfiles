{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#9fcafd",
      "2": "#d6bee5",
      "3": "#bac8db"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#e1e2e8"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#9fcafd"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#9fcafd"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#d6bee5"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#bac8db"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#35618e"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
